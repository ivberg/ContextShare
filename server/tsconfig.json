{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
  "outDir": "dist",
  "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@contextshare/shared/*": ["shared/*"]
    }
  },
  "include": ["src", "../shared/catalogExportTypes.ts"],
  "exclude": ["node_modules", "dist"]
}
