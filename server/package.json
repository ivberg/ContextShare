{
  "name": "contextshare-server",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "generate:types": "echo 'No extra types to generate yet'",
    "build": "tsc -p .",
    "dev": "node --watch dist/index.js",
    "start": "node dist/src/index.js",
    "prebuild": "npm run generate:types || exit 0",
    "test": "mocha --config .mocharc.cjs",
    "lint": "eslint src/**/*.ts",
    "lint:error": "eslint src/**/*.ts --quiet",
    "lint:fix": "eslint src/**/*.ts --fix",
    "db:migrate": "kysely-migration-cli migrate",
    "db:create-migration": "kysely-migration-cli create",
    "db:query": "node dist/tools/db-query.js",
    "deploy:azure": "node scripts/deploy-azure.mjs"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "better-sqlite3": "^11.5.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "http-proxy-middleware": "^3.0.5",
    "kysely": "^0.27.4",
    "yazl": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.10",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "kysely-migration-cli": "^0.4.2",
    "mocha": "^11.7.2",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
