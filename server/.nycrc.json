{
  "extends": "@istanbuljs/nyc-config-typescript",
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/test/**",
    "dist/**",
    "node_modules/**"
  ],
  "reporter": [
    "text",
    "text-summary",
    "html",
    "lcov"
  ],
  "report-dir": "coverage",
  "cache": false,
  "all": true,
  "check-coverage": true,
  "statements": 70,
  "branches": 60,
  "functions": 70,
  "lines": 70
}